generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(uuid())
  username    String         @unique
  password    String
  avatarUrl   String?
  bannerUrl   String?
  bannerColor String?
  statusText  String?
  statusEmoji String?
  createdAt   DateTime       @default(now())
  memberships ServerMember[]
  messages    Message[]
  badges      UserBadge[]
  invites     Invite[]

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")

  friendshipsAsA Friendship[] @relation("FriendshipUserA")
  friendshipsAsB Friendship[] @relation("FriendshipUserB")

  sentDMs     DirectMessage[] @relation("DMSender")
  receivedDMs DirectMessage[] @relation("DMRecipient")

  addedTracks PlaylistTrack[]
}

model Server {
  id              String           @id @default(uuid())
  name            String
  ownerId         String
  createdAt       DateTime         @default(now())
  channels        Channel[]
  members         ServerMember[]
  soundboardClips SoundboardClip[]
  invites         Invite[]
  customEmojis    CustomEmoji[]
}

// A server-uploaded emoji, either added one at a time or imported as part
// of a pack. `animated` distinguishes GIF/WEBP uploads so the picker and
// message renderer know to treat them as animated rather than static.
model CustomEmoji {
  id         String   @id @default(uuid())
  serverId   String
  name       String
  url        String
  animated   Boolean  @default(false)
  uploaderId String
  createdAt  DateTime @default(now())
  server     Server   @relation(fields: [serverId], references: [id])

  // Names are unique per-server so ":partyparrot:" always resolves to one
  // emoji within a given server, the same way Discord scopes custom emoji.
  @@unique([serverId, name])
}

// A short MP3 clip a member uploaded for instant playback in this server's voice channels.
model SoundboardClip {
  id         String   @id @default(uuid())
  name       String
  url        String
  serverId   String
  uploaderId String
  createdAt  DateTime @default(now())
  server     Server   @relation(fields: [serverId], references: [id])
}

model Channel {
  id             String          @id @default(uuid())
  name           String
  type           String          @default("voice")
  isEphemeral    Boolean         @default(false)
  serverId       String
  server         Server          @relation(fields: [serverId], references: [id])
  messages       Message[]
  playlistTracks PlaylistTrack[]
}

// A persisted text message in a channel. Sender name/avatar are snapshotted
// at send-time so history still renders correctly even if the user later
// changes their name or avatar.
model Message {
  id              String     @id @default(uuid())
  channelId       String
  senderId        String
  sender          String
  senderAvatarUrl String?
  content         String
  attachmentUrl   String?
  attachmentKind  String?
  pinned          Boolean    @default(false)
  editedAt        DateTime?
  createdAt       DateTime   @default(now())
  channel         Channel    @relation(fields: [channelId], references: [id])
  user            User       @relation(fields: [senderId], references: [id])
  reactions       Reaction[]

  @@index([channelId])
}

// A single emoji reaction from one user on one message. One row per
// (message, user, emoji) triple — a user can react with several different
// emoji on the same message, but can't stack the same one twice; toggling
// the same emoji again removes it.
model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  username  String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Join table: who belongs to which server, and with what role.
// role is one of: "owner" | "admin" | "member"
model ServerMember {
  id       String @id @default(uuid())
  userId   String
  serverId String
  role     String @default("member")
  user     User   @relation(fields: [userId], references: [id])
  server   Server @relation(fields: [serverId], references: [id])

  @@unique([userId, serverId])
}

// A shareable join code for a server. Optional expiry and use-limit.
model Invite {
  id          String    @id @default(uuid())
  code        String    @unique
  serverId    String
  createdById String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  server      Server    @relation(fields: [serverId], references: [id])
  createdBy   User      @relation(fields: [createdById], references: [id])
}

// A pending/accepted/declined friend request between two accounts.
model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now())
  sender      User     @relation("FriendRequestSender", fields: [senderId], references: [id])
  recipient   User     @relation("FriendRequestRecipient", fields: [recipientId], references: [id])

  @@unique([senderId, recipientId])
}

// A confirmed, symmetric friendship. userAId is always the lexicographically
// smaller id so a pair only ever has one row, regardless of who accepted.
model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

// A direct message between two friends, outside any server.
model DirectMessage {
  id             String   @id @default(uuid())
  senderId       String
  recipientId    String
  content        String
  attachmentUrl  String?
  attachmentKind String?
  createdAt      DateTime @default(now())
  sender         User     @relation("DMSender", fields: [senderId], references: [id])
  recipient      User     @relation("DMRecipient", fields: [recipientId], references: [id])

  @@index([senderId, recipientId])
}

// Small account-level badges (Founder, Supporter, etc) shown next to a
// username everywhere, separate from per-server roles.
model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  key       String
  label     String
  color     String   @default("#d4a24c")
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

// A saved track for the channel's collaborative playlist
model PlaylistTrack {
  id        String   @id @default(uuid())
  channelId String
  videoId   String
  title     String
  url       String
  addedById String
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  addedBy   User     @relation(fields: [addedById], references: [id])

  @@index([channelId])
}